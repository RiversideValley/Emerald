<UserControl
    x:Class="Emerald.Controls.QuickProfileEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Emerald.Helpers.Converters"
    xmlns:helpers="using:Emerald.Helpers"
    xmlns:local="using:Emerald.Controls"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    Loaded="Editor_Loaded">
    <UserControl.Resources>
        <conv:BoolToVisibility x:Key="Visible" />
        <Style x:Key="PickerGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style x:Key="GlyphPickerGridViewItemStyle" BasedOn="{StaticResource PickerGridViewItemStyle}" TargetType="GridViewItem">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="72" />
        </Style>
        <Style x:Key="BlockPickerGridViewItemStyle" BasedOn="{StaticResource PickerGridViewItemStyle}" TargetType="GridViewItem">
            <Setter Property="Width" Value="184" />
            <Setter Property="Height" Value="72" />
        </Style>
        <Style x:Key="ColorPickerGridViewItemStyle" BasedOn="{StaticResource PickerGridViewItemStyle}" TargetType="GridViewItem">
            <Setter Property="Width" Value="164" />
            <Setter Property="Height" Value="44" />
        </Style>
    </UserControl.Resources>

    <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
        <Border
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <local:QuickProfileContent Profile="{Binding Preview}" />
        </Border>

      <ScrollViewer Grid.Row="1">

      <StackPanel Spacing="16" HorizontalAlignment="Stretch">
        <TextBox Header="{helpers:Localize KeyName=RefineName}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <settings:SettingsExpander
            x:Name="Setup"
            Description="{Binding SetupSummary}"
            Header="{helpers:Localize KeyName=RefineLaunchSetup}"
            HorizontalAlignment="Stretch">
            <settings:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE768;" />
            </settings:SettingsExpander.HeaderIcon>
            <settings:SettingsExpander.Items>
                <StackPanel Padding="16,12,16,16" Spacing="12">
                    <ComboBox Header="{helpers:Localize KeyName=RefineInstance}" DisplayMemberPath="Version.DisplayName" HorizontalAlignment="Stretch" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}" />
                    <ComboBox Header="{helpers:Localize KeyName=RefineAccount}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}" />
                    <ComboBox Header="{helpers:Localize KeyName=RefineDestination}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" ItemsSource="{Binding Destinations}" SelectedItem="{Binding Destination, Mode=TwoWay}" />
                    <ComboBox Header="{helpers:Localize KeyName=RefineServer}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer, Mode=TwoWay}" Visibility="{Binding IsServer, Converter={StaticResource Visible}}" />
                    <ComboBox Header="{helpers:Localize KeyName=RefineWorld}" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" ItemsSource="{Binding Worlds}" SelectedItem="{Binding SelectedWorld, Mode=TwoWay}" Visibility="{Binding IsWorld, Converter={StaticResource Visible}}" />
                </StackPanel>
            </settings:SettingsExpander.Items>
        </settings:SettingsExpander>

        <settings:SettingsExpander Header="{helpers:Localize KeyName=RefineIcon}" HorizontalAlignment="Stretch">
            <settings:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE790;" />
            </settings:SettingsExpander.HeaderIcon>
            <settings:SettingsExpander.Items>
                <StackPanel Padding="16,12,16,16" Spacing="12">
                    <TextBlock Text="{helpers:Localize KeyName=RefineIcon}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBox
                        x:Name="IconSearch"
                        AutomationProperties.Name="{helpers:Localize KeyName=RefineSearchIcons}"
                        PlaceholderText="{helpers:Localize KeyName=RefineSearchIcons}"
                        TextChanged="IconSearch_TextChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton x:Name="GlyphTypeButton" Click="GlyphType_Click" Content="{helpers:Localize KeyName=RefineGlyphs}" />
                        <ToggleButton x:Name="BlockTypeButton" Click="BlockType_Click" Content="{helpers:Localize KeyName=RefineMinecraftBlocks}" />
                    </StackPanel>
                    <GridView
                        x:Name="GlyphChoices"
                        IsItemClickEnabled="True"
                        IsSwipeEnabled="False"
                        ItemClick="GlyphChoices_ItemClick"
                        ItemContainerStyle="{StaticResource GlyphPickerGridViewItemStyle}"
                        ItemsSource="{x:Bind GlyphItems}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        SelectionMode="Single">
                        <GridView.Resources>
                            <CornerRadius x:Key="GridViewItemCornerRadius">8</CornerRadius>
                        </GridView.Resources>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <FontIcon FontSize="24" Glyph="{Binding Glyph}" HorizontalAlignment="Center" />
                                    <TextBlock HorizontalAlignment="Center" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <StackPanel x:Name="BlockPicker" Spacing="12">
                        <GridView
                            x:Name="BlockChoices"
                            IsItemClickEnabled="True"
                            IsSwipeEnabled="False"
                            ItemClick="BlockChoices_ItemClick"
                            ItemContainerStyle="{StaticResource BlockPickerGridViewItemStyle}"
                            ItemsSource="{x:Bind BlockItems}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            SelectionMode="Single">
                            <GridView.Resources>
                                <CornerRadius x:Key="GridViewItemCornerRadius">8</CornerRadius>
                            </GridView.Resources>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="40" Height="40" Source="{Binding Image}" Stretch="Uniform" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" MaxLines="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviousBlockButton" Click="PreviousBlock_Click" Content="{helpers:Localize KeyName=RefinePrevious}" />
                            <TextBlock x:Name="BlockPageText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button x:Name="NextBlockButton" Grid.Column="2" Click="NextBlock_Click" Content="{helpers:Localize KeyName=RefineNext}" />
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </settings:SettingsExpander.Items>
        </settings:SettingsExpander>

        <settings:SettingsExpander Header="{helpers:Localize KeyName=RefineAccent}" HorizontalAlignment="Stretch">
            <settings:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE790;" />
            </settings:SettingsExpander.HeaderIcon>
            <settings:SettingsExpander.Items>
                <StackPanel Padding="16,12,16,16" Spacing="12">
                    <GridView
                        x:Name="ColorChoices"
                        IsItemClickEnabled="True"
                        IsSwipeEnabled="False"
                        ItemClick="ColorChoices_ItemClick"
                        ItemContainerStyle="{StaticResource ColorPickerGridViewItemStyle}"
                        ItemsSource="{x:Bind ColorItems}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        SelectionMode="Single">
                        <GridView.Resources>
                            <CornerRadius x:Key="GridViewItemCornerRadius">8</CornerRadius>
                        </GridView.Resources>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="18" Height="18" Background="{Binding Brush}" CornerRadius="9" />
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <Button HorizontalAlignment="Left">
                        <Button.Flyout>
                            <Flyout>
                                <ColorPicker
                                    x:Name="CustomColorPicker"
                                    ColorChanged="CustomColorPicker_ColorChanged"
                                    ColorSpectrumShape="Box"
                                    IsAlphaEnabled="False"
                                    IsColorChannelTextInputVisible="True"
                                    IsColorSliderVisible="True"
                                    IsHexInputVisible="True"
                                    IsMoreButtonVisible="False" />
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border x:Name="CustomColorSwatch" Width="18" Height="18" CornerRadius="9" />
                            <TextBlock Text="{helpers:Localize KeyName=RefineCustomColor}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </settings:SettingsExpander.Items>
        </settings:SettingsExpander>

        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />
        <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{Binding Error}" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
      </StackPanel>
      </ScrollViewer>
    </Grid>
</UserControl>
