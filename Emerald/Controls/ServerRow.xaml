<UserControl x:Class="Emerald.Controls.ServerRow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="using:Emerald.Helpers">
 <Grid x:Name="Root" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Button Click="Select_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{Binding Name}">
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}"><Grid><FontIcon Glyph="&#xE968;"/><Image Source="{Binding Icon}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Motd}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Metadata}" TextWrapping="Wrap" MaxLines="2" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"/></Grid>
  </Button>
  <Grid Grid.Row="1" Margin="16,0,16,12" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" ToolTipService.ToolTip="{Binding StatusHelp}" VerticalAlignment="Center" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"/><Button Grid.Column="1" Click="Favorite_Click" AutomationProperties.Name="{helpers:Localize KeyName=RefineToggleFavorite}" ToolTipService.ToolTip="{helpers:Localize KeyName=RefineToggleFavorite}"><FontIcon Glyph="{Binding FavoriteGlyph}"/></Button><Button Grid.Column="2" Click="Menu_Click" AutomationProperties.Name="{helpers:Localize KeyName=RefineServerOptions}" ToolTipService.ToolTip="{helpers:Localize KeyName=RefineServerOptions}"><FontIcon Glyph="&#xE712;"/></Button><Button Grid.Column="3" Click="Play_Click" Content="{helpers:Localize KeyName=RefinePlay}"/></Grid>
 </Grid>
</UserControl>
