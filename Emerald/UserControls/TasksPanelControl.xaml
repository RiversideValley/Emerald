<UserControl
    x:Class="Emerald.UserControls.TasksPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Emerald.Helpers"
    xmlns:uc="using:Emerald.UserControls">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="HeaderGrid" Grid.Row="0" Padding="24,24,24,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel HorizontalAlignment="Left" Grid.Column="0" Spacing="4">
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{helpers:Localize KeyName=Tasks}" />
        <TextBlock
          x:Name="TaskIntroTextBlock"
          MaxWidth="720"
          Opacity="0.7"
          Style="{StaticResource CaptionTextBlockStyle}"
          Text="{helpers:Localize KeyName=TaskIntro}"
          TextWrapping="WrapWholeWords" />
      </StackPanel>

      <CommandBar
        Grid.Column="1"
        Background="Transparent"
        DefaultLabelPosition="Right"
        VerticalAlignment="Center">
        <AppBarButton
          x:Name="CompactModeButton"
          Click="CompactModeButton_Click">
          <AppBarButton.Icon>
            <FontIcon Glyph="&#xE8A7;" />
          </AppBarButton.Icon>
        </AppBarButton>
        <AppBarButton
          x:Name="ClearAllButton"
          Click="ClearAllButton_Click"
          Label="{helpers:Localize KeyName=ClearAll}"
          ToolTipService.ToolTip="{helpers:Localize KeyName=ClearAll}">
          <AppBarButton.Icon>
            <FontIcon Glyph="&#xE894;" />
          </AppBarButton.Icon>
        </AppBarButton>
      </CommandBar>
    </Grid>

    <Grid x:Name="ContentHost" Grid.Row="1" Margin="24,0,24,24">
      <uc:NotificationListControl />
    </Grid>
  </Grid>
</UserControl>
