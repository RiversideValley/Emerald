<ContentDialog
    x:Class="Emerald.Views.GameOptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Emerald.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gameOptions="using:Emerald.CoreX.GameOptions"
    xmlns:helpers="using:Emerald.Helpers"
    xmlns:local="using:Emerald.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FullSizeDesired="True"
    VerticalAlignment="Stretch"
    HorizontalAlignment="Stretch"
    MaxWidth="4096"
    Margin="12"
    Background="{ThemeResource ContentDialogBackground}"
    mc:Ignorable="d">

  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
    <x:Double x:Key="ContentDialogMaxHeight">2048</x:Double>
    <conv:BoolToVisibility x:Key="BoolToVis" />
    <conv:BoolToVisibility x:Key="InverseBoolToVis" Reversed="True" />

    <!-- ── Boolean ── -->
    <DataTemplate x:Key="BooleanTemplate" x:DataType="gameOptions:MinecraftOptionEntry">
      <Border
        Margin="0,3"
        Padding="14,10"
        CornerRadius="10"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                       Text="{x:Bind DisplayName}" />
            <TextBlock Opacity="0.55" Style="{StaticResource CaptionTextBlockStyle}"
                       Text="{x:Bind Key}" />
          </StackPanel>
          <ToggleSwitch
            Grid.Column="1"
            IsOn="{x:Bind IsBooleanTrue, Mode=TwoWay}"
            OffContent="{helpers:Localize KeyName=GameOptionsOff}"
            OnContent="{helpers:Localize KeyName=GameOptionsOn}"
            VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- ── Unsupported and device-specific values (read-only) ── -->
    <DataTemplate x:Key="ReadOnlyTemplate" x:DataType="gameOptions:MinecraftOptionEntry">
      <Border Margin="0,3" Padding="14,10" CornerRadius="10"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Opacity="0.75">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" />
            <TextBlock Opacity="0.55" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Key}" />
          </StackPanel>
          <TextBlock Grid.Column="1" MaxWidth="260" TextTrimming="CharacterEllipsis"
                     FontFamily="Cascadia Mono" Style="{StaticResource CaptionTextBlockStyle}"
                     Text="{x:Bind RawValue}" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- ── Slider (int + float shared) ── -->
    <DataTemplate x:Key="SliderTemplate" x:DataType="gameOptions:MinecraftOptionEntry">
      <Border
        Margin="0,3"
        Padding="14,10"
        CornerRadius="10"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1">
        <StackPanel Spacing="10">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
              <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" />
              <TextBlock Opacity="0.55" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Key}" />
            </StackPanel>
            <TextBlock
              Grid.Column="1"
              Style="{StaticResource BodyStrongTextBlockStyle}"
              VerticalAlignment="Center"
              Text="{x:Bind DisplayValueLabel, Mode=OneWay}" />
          </Grid>
          <Slider
            Minimum="{x:Bind SliderMin}"
            Maximum="{x:Bind SliderMax}"
            StepFrequency="{x:Bind SliderStep}"
            SmallChange="{x:Bind SliderStep}"
            Value="{x:Bind SliderValue, Mode=TwoWay}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- ── Enum / ComboBox ── -->
    <DataTemplate x:Key="EnumTemplate" x:DataType="gameOptions:MinecraftOptionEntry">
      <Border
        Margin="0,3"
        Padding="14,10"
        CornerRadius="10"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" />
            <TextBlock Opacity="0.55" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Key}" />
          </StackPanel>
          <ComboBox
            Grid.Column="1"
            MinWidth="160"
            ItemsSource="{x:Bind EnumOptions}"
            SelectedItem="{x:Bind SelectedEnumOption, Mode=TwoWay}"
            VerticalAlignment="Center">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="gameOptions:MinecraftEnumOption">
                <TextBlock Text="{x:Bind DisplayLabel}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- ── Sound volume slider ── -->
    <DataTemplate x:Key="SoundTemplate" x:DataType="gameOptions:MinecraftOptionEntry">
      <Border
        Margin="0,3"
        Padding="14,10"
        CornerRadius="10"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1">
        <StackPanel Spacing="10">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
              <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" />
              <TextBlock Opacity="0.55" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Key}" />
            </StackPanel>
            <TextBlock
              Grid.Column="1"
              Style="{StaticResource BodyStrongTextBlockStyle}"
              VerticalAlignment="Center"
              Text="{x:Bind DisplayValueLabel, Mode=OneWay}" />
          </Grid>
          <Slider
            Minimum="0" Maximum="1" StepFrequency="0.01" SmallChange="0.01"
            Value="{x:Bind SliderValue, Mode=TwoWay}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- ── Key binding (read-only) ── -->
    <DataTemplate x:Key="KeyBindTemplate" x:DataType="gameOptions:MinecraftOptionEntry">
      <Border
        Margin="0,3"
        Padding="14,10"
        CornerRadius="10"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        Opacity="0.75">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" />
            <TextBlock Opacity="0.55" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Key}" />
          </StackPanel>
          <Border
            Grid.Column="1"
            Padding="10,5"
            CornerRadius="6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            VerticalAlignment="Center">
            <TextBlock
              FontFamily="Cascadia Mono"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="{x:Bind DisplayValueLabel}" />
          </Border>
        </Grid>
      </Border>
    </DataTemplate>

    <local:OptionTemplateSelector
      x:Key="TemplateSelector"
      BooleanTemplate="{StaticResource BooleanTemplate}"
      SliderTemplate="{StaticResource SliderTemplate}"
      EnumTemplate="{StaticResource EnumTemplate}"
      SoundTemplate="{StaticResource SoundTemplate}"
      KeyBindTemplate="{StaticResource KeyBindTemplate}"
      ReadOnlyTemplate="{StaticResource ReadOnlyTemplate}" />
  </ContentDialog.Resources>

  <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── Header ── -->
    <Border Grid.Row="0" Padding="20,20,20,14">
      <StackPanel Spacing="14">
        <StackPanel Spacing="4">
          <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{helpers:Localize KeyName=GameOptionsTitle}" />
          <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.GameDisplayName, Mode=OneWay}" />
        </StackPanel>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="180" />
          </Grid.ColumnDefinitions>
          <AutoSuggestBox
            PlaceholderText="{helpers:Localize KeyName=GameOptionsSearchPlaceholder}"
            QueryIcon="Find"
            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <ComboBox
            Grid.Column="1"
            ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- ── Body ── -->
    <Grid Grid.Row="1" Padding="20,0,20,0">

      <!-- Loading -->
      <StackPanel
        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
        <ProgressRing IsActive="True" />
        <TextBlock HorizontalAlignment="Center" Text="{helpers:Localize KeyName=GameOptionsLoading}" />
      </StackPanel>

      <!-- No options.txt yet -->
      <StackPanel
        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
        Visibility="{x:Bind ViewModel.OptionsFileExists, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
        <FontIcon FontSize="48" Glyph="&#xE8A5;" Opacity="0.45" />
        <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}"
                   Text="{helpers:Localize KeyName=GameOptionsNoFileTitle}" />
        <TextBlock
          MaxWidth="340" HorizontalAlignment="Center"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Style="{StaticResource CaptionTextBlockStyle}"
          Text="{helpers:Localize KeyName=GameOptionsNoFileDescription}"
          TextAlignment="Center" TextWrapping="WrapWholeWords" />
      </StackPanel>

      <!-- Empty search result -->
      <StackPanel
        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
        Visibility="{x:Bind ViewModel.ShowEmptySearch, Mode=OneWay, Converter={StaticResource BoolToVis}}">
        <FontIcon FontSize="40" Glyph="&#xE721;" Opacity="0.45" />
        <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}"
                   Text="{helpers:Localize KeyName=GameOptionsNoMatchesTitle}" />
        <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Text="{helpers:Localize KeyName=GameOptionsNoMatchesDescription}" />
      </StackPanel>

      <!-- Options list -->
      <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        Visibility="{x:Bind ViewModel.HasOptions, Mode=OneWay, Converter={StaticResource BoolToVis}}">
        <ListView
          ItemsSource="{x:Bind ViewModel.FilteredEntries, Mode=OneWay}"
          ItemTemplateSelector="{StaticResource TemplateSelector}"
          SelectionMode="None">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
            </Style>
          </ListView.ItemContainerStyle>
        </ListView>
      </ScrollViewer>

      <Border HorizontalAlignment="Stretch" VerticalAlignment="Top" Padding="12" CornerRadius="8"
              Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
              Visibility="{x:Bind ViewModel.HasSaveConflict, Mode=OneWay, Converter={StaticResource BoolToVis}}">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{x:Bind ViewModel.ConflictMessage, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="{helpers:Localize KeyName=GameOptionsReload}"
                  Command="{x:Bind ViewModel.ReloadCommand}" />
        </Grid>
      </Border>
    </Grid>

    <!-- ── Footer ── -->
    <Border
      Grid.Row="2"
      Margin="-36,0,0,-6"
      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{ThemeResource SystemControlBackgroundBaseLowRevealBorderBrush}"
      Padding="30,14,20,20">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Click="Close_Click" Content="{helpers:Localize KeyName=Close}" />
        <Button
          Grid.Column="2"
          Click="Save_Click"
          Content="{helpers:Localize KeyName=GameOptionsSave}"
          Style="{ThemeResource AccentButtonStyle}"
          IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}" />
      </Grid>
    </Border>
  </Grid>
</ContentDialog>
