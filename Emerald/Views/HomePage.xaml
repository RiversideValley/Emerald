<Page x:Class="Emerald.Views.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="using:Emerald.Helpers.Converters" xmlns:vm="using:Emerald.ViewModels" xmlns:controls="using:Emerald.Controls" xmlns:helpers="using:Emerald.Helpers" Background="Transparent">
 <Page.Resources><conv:BoolToVisibility x:Key="Visible"/></Page.Resources>
 <ScrollViewer HorizontalScrollBarVisibility="Disabled">
 <Grid x:Name="LayoutRoot" Padding="24" RowSpacing="24" SizeChanged="Layout_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="HeroGrid" ColumnSpacing="16" RowSpacing="16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Padding="24" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
    <StackPanel Spacing="16">
     <Button Click="Accounts_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{helpers:Localize KeyName=RefineChooseAccount}">
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Width="48" Height="48" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}"><Grid><FontIcon Glyph="&#xE77B;"/><Image Source="{x:Bind ViewModel.AccountAvatar, Mode=OneWay}"/></Grid></Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{helpers:Localize KeyName=RefinePlayingAs}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.AccountName, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.AccountName, Mode=OneWay}"/></StackPanel>
       <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"/>
      </Grid>
     </Button>
     <ComboBox Header="{helpers:Localize KeyName=RefineInstance}" ItemsSource="{x:Bind ViewModel.Games}" SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}" DisplayMemberPath="Version.DisplayName" HorizontalAlignment="Stretch" PlaceholderText="{helpers:Localize KeyName=RefineChooseInstance}"/>
     <TextBlock Text="{x:Bind ViewModel.InstanceDetails, Mode=OneWay}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}"/>
     <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12" AutomationProperties.Name="{helpers:Localize KeyName=RefineDestination}">
      <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="{helpers:Localize KeyName=RefineMainMenu}" Click="MainMenu_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem Text="{helpers:Localize KeyName=RefineBrowseWorlds}" Click="Worlds_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE909;"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem Text="{helpers:Localize KeyName=RefineBrowseServers}" Click="Servers_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE968;"/></MenuFlyoutItem.Icon></MenuFlyoutItem></MenuFlyout></Button.Flyout>
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Width="48" Height="48" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}"><Grid><FontIcon Glyph="{x:Bind ViewModel.DestinationGlyph, Mode=OneWay}"/><controls:WorldThumbnail Path="{x:Bind ViewModel.DestinationImage, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsWorldDestination, Mode=OneWay, Converter={StaticResource Visible}}"/><Image Source="{x:Bind ViewModel.DestinationServerIcon, Mode=OneWay}" Stretch="UniformToFill" Visibility="{x:Bind ViewModel.IsServerDestination, Mode=OneWay, Converter={StaticResource Visible}}"/></Grid></Border>
       <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind ViewModel.DestinationTitle, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind ViewModel.DestinationSubtitle, Mode=OneWay}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.DestinationServerMetadata, Mode=OneWay}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" Visibility="{x:Bind ViewModel.IsServerDestination, Mode=OneWay, Converter={StaticResource Visible}}"/><TextBlock Text="{x:Bind ViewModel.DestinationServerStatus, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Visibility="{x:Bind ViewModel.IsServerDestination, Mode=OneWay, Converter={StaticResource Visible}}"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="12"/>
      </Grid>
     </Button>
     <InfoBar IsOpen="{x:Bind ViewModel.HasLaunchMessage, Mode=OneWay}" Severity="Warning" IsClosable="False" Message="{x:Bind ViewModel.LaunchMessage, Mode=OneWay}"/>
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}" Click="Primary_Click" IsEnabled="{x:Bind ViewModel.CanPlay, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" MinWidth="132" Padding="24,12"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBlock Text="{x:Bind ViewModel.RuntimeElapsedText, Mode=OneWay}" VerticalAlignment="Center"/><Button Content="{helpers:Localize KeyName=RefineStop}" Command="{x:Bind ViewModel.StopCommand}" Visibility="{x:Bind ViewModel.SelectedGame.HasActiveSession, Mode=OneWay, Converter={StaticResource Visible}}"/></StackPanel>
      <Button Grid.Column="2" Visibility="{x:Bind ViewModel.SelectedGame.HasActiveSession, Mode=OneWay, Converter={StaticResource Visible}}" AutomationProperties.Name="{helpers:Localize KeyName=RefineRuntimeOptions}"><FontIcon Glyph="&#xE712;"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="{helpers:Localize KeyName=RefineForceStop}" Command="{x:Bind ViewModel.ForceStopCommand}"/></MenuFlyout></Button.Flyout></Button>
     </Grid>
    </StackPanel>
   </Border>
   <Border x:Name="PlaytimeCard" Grid.Column="1" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
    <Grid Padding="20" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{helpers:Localize KeyName=RefinePlaytime}" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.PlaytimeScopes}" SelectedIndex="{x:Bind ViewModel.PlaytimeScopeIndex, Mode=TwoWay}" AutomationProperties.Name="{helpers:Localize KeyName=RefinePlaytimeScope}"/></Grid>
     <Button Grid.Row="1" Click="PlaytimeCard_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="12" AutomationProperties.Name="{helpers:Localize KeyName=RefineViewPlaytime}">
      <Grid RowSpacing="16" MinHeight="250"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="{helpers:Localize KeyName=RefineLifetime}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.TotalPlaytimeText, Mode=OneWay}" FontSize="36" FontWeight="SemiBold"/></StackPanel>
       <Grid Grid.Row="1" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{helpers:Localize KeyName=RefineThisWeek}" Style="{ThemeResource CaptionTextBlockStyle}"/><TextBlock Text="{x:Bind ViewModel.WeekPlaytimeText, Mode=OneWay}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{helpers:Localize KeyName=RefineSessions}" Style="{ThemeResource CaptionTextBlockStyle}"/><TextBlock Text="{x:Bind ViewModel.SessionCountText, Mode=OneWay}"/></StackPanel></Grid>
       <Grid Grid.Row="2" VerticalAlignment="Bottom"><ItemsControl ItemsSource="{x:Bind ViewModel.HomeDailyBars, Mode=OneWay}" HorizontalContentAlignment="Stretch"><ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:EqualColumnPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PlaytimeBarViewModel"><Grid Height="112" ToolTipService.ToolTip="{x:Bind Duration}" AutomationProperties.Name="{x:Bind Duration}"><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="24"/></Grid.RowDefinitions><Border Height="1" VerticalAlignment="Bottom" Background="{ThemeResource CardStrokeColorDefaultBrush}"/><Border Height="{x:Bind Height}" VerticalAlignment="Bottom" CornerRadius="3" Background="{ThemeResource AccentFillColorDefaultBrush}"/><TextBlock Grid.Row="1" Text="{x:Bind Label}" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
       <Grid Grid.Row="3"><TextBlock Text="{helpers:Localize KeyName=RefineViewPlaytime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><FontIcon Glyph="&#xE76C;" FontSize="12" HorizontalAlignment="Right"/></Grid>
      </Grid>
     </Button>
    </Grid>
   </Border>
  </Grid>
  <StackPanel Grid.Row="1" Spacing="16"><Grid><TextBlock Text="{helpers:Localize KeyName=RefineQuickProfiles}" Style="{ThemeResource SubtitleTextBlockStyle}"/><Button Content="{helpers:Localize KeyName=RefineNewProfile}" HorizontalAlignment="Right" Click="AddProfile_Click"/></Grid>
   <ItemsControl ItemsSource="{x:Bind ViewModel.QuickProfiles, Mode=OneWay}" HorizontalContentAlignment="Stretch"><ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ResponsiveCardPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:QuickProfileCardViewModel">
    <Grid MinHeight="144" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
     <Button Tag="{x:Bind Profile}" Click="ProfileSelect_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="0,0,0,40" CornerRadius="12" AutomationProperties.Name="{x:Bind Name}"><controls:QuickProfileContent Profile="{x:Bind}"/></Button>
     <Border BorderThickness="2" CornerRadius="12" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource Visible}}"/>
     <FontIcon Glyph="&#xE73E;" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource Visible}}"/>
     <FontIcon Glyph="&#xE7BA;" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" Visibility="{x:Bind NeedsAttention, Converter={StaticResource Visible}}" AutomationProperties.Name="{helpers:Localize KeyName=RefineNeedsAttention}"/>
     <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,4"><Button Tag="{x:Bind Profile}" Click="ProfileMenu_Click" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{helpers:Localize KeyName=RefineProfileOptions}" ToolTipService.ToolTip="{helpers:Localize KeyName=RefineProfileOptions}"><FontIcon Glyph="&#xE712;"/></Button><Button Tag="{x:Bind Profile}" Click="ProfilePlay_Click" IsEnabled="{x:Bind CanLaunch}" AutomationProperties.Name="{helpers:Localize KeyName=RefineLaunchNow}" ToolTipService.ToolTip="{helpers:Localize KeyName=RefineLaunchNow}"><FontIcon Glyph="&#xE768;"/></Button></StackPanel>
    </Grid>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="{helpers:Localize KeyName=RefineNoProfiles}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ViewModel.HasProfiles, Mode=OneWay, Converter={StaticResource Visible}, ConverterParameter=reversed}"/>
  </StackPanel>
  <Grid x:Name="ShortcutGrid" Grid.Row="2" ColumnSpacing="16" RowSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="104" Padding="16" CornerRadius="12" Click="Servers_Click"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE968;"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6"><TextBlock Text="{helpers:Localize KeyName=RefineServers}" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="{x:Bind ViewModel.FavoriteServerStatus, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"/></Grid></Button><Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="104" Padding="16" CornerRadius="12" Click="Worlds_Click"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE909;"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6"><TextBlock Text="{helpers:Localize KeyName=RefineLocalWorlds}" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="{x:Bind ViewModel.MostRecentWorldText, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"/></Grid></Button><Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="104" Padding="16" CornerRadius="12" Click="Logs_Click"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE756;"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6"><TextBlock Text="{helpers:Localize KeyName=RefineRecentActivity}" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="{x:Bind ViewModel.RuntimeStatus, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"/></Grid></Button></Grid><StackPanel Grid.Row="3" Spacing="12" Visibility="{x:Bind ViewModel.HasGames, Mode=OneWay, Converter={StaticResource Visible}, ConverterParameter=reversed}"><TextBlock Text="{helpers:Localize KeyName=RefineNoInstances}"/><Button Content="{helpers:Localize KeyName=RefineOpenInstances}" Click="Instances_Click"/></StackPanel></Grid></ScrollViewer></Page>
