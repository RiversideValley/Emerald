<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Emerald.ViewModels"
      xmlns:controls="using:Emerald.Controls" xmlns:helpers="using:Emerald.Helpers"
      x:Class="Emerald.Views.PlaytimePage" Background="Transparent">
  <Page.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Padding" Value="20" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Chart marks keep keyboard focus and tooltips without the standard button chrome. -->
    <Style x:Key="ChartMark" TargetType="Button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter Content="{TemplateBinding Content}" Background="Transparent"
                              HorizontalContentAlignment="Stretch" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HeatmapMark" TargetType="Button" BasedOn="{StaticResource ChartMark}">
      <Setter Property="Height" Value="22" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Height="18" VerticalAlignment="Center" CornerRadius="2"
                    Background="{TemplateBinding Background}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="BarTemplate" x:DataType="vm:PlaytimeBarViewModel">
      <Button Style="{StaticResource ChartMark}" AutomationProperties.Name="{x:Bind Duration}"
              ToolTipService.ToolTip="{x:Bind Duration}">
        <Grid Height="164">
          <Grid.RowDefinitions>
            <RowDefinition Height="136" />
            <RowDefinition Height="28" />
          </Grid.RowDefinitions>
          <Border Height="1" VerticalAlignment="Bottom" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
          <Border Height="{x:Bind Height}" VerticalAlignment="Bottom"
                  Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="3" />
          <TextBlock Grid.Row="1" Text="{x:Bind Label}" Style="{ThemeResource CaptionTextBlockStyle}"
                     TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
        </Grid>
      </Button>
    </DataTemplate>
  </Page.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="LayoutRoot" Padding="24" Spacing="24" SizeChanged="Layout_SizeChanged">
      <Grid ColumnSpacing="12" RowSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button Click="Back_Click" AutomationProperties.Name="{helpers:Localize KeyName=RefineBack}">
          <FontIcon Glyph="&#xE72B;" />
        </Button>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{helpers:Localize KeyName=RefinePlaytime}" Style="{ThemeResource TitleTextBlockStyle}" />
          <TextBlock Text="{x:Bind ViewModel.PeriodText, Mode=OneWay}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ComboBox x:Name="ScopePicker" Grid.Column="2" MaxWidth="240" ItemsSource="{x:Bind ViewModel.Scopes}"
                  SelectedItem="{x:Bind ViewModel.SelectedScope, Mode=TwoWay}" DisplayMemberPath="Label"
                  AutomationProperties.Name="{helpers:Localize KeyName=RefinePlaytimeScope}" />
        <ComboBox x:Name="RangePicker" Grid.Column="3" ItemsSource="{x:Bind ViewModel.Ranges}"
                  SelectedItem="{x:Bind ViewModel.SelectedRange, Mode=TwoWay}" DisplayMemberPath="Label"
                  AutomationProperties.Name="{helpers:Localize KeyName=RefineDateRange}" />
      </Grid>
      <ItemsRepeater ItemsSource="{x:Bind ViewModel.Kpis, Mode=OneWay}">
        <ItemsRepeater.Layout>
          <UniformGridLayout x:Name="KpiLayout" MinItemWidth="140" MinItemHeight="96" MinColumnSpacing="12"
                             MinRowSpacing="12" ItemsStretch="Fill" MaximumRowsOrColumns="5" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="vm:PlaytimeKpiViewModel">
            <Border Style="{StaticResource Card}" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Label}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Value}" FontSize="24" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
      <Border Style="{StaticResource Card}">
        <StackPanel Spacing="16">
          <Grid>
            <TextBlock Text="{x:Bind ViewModel.ChartTitle, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.ChartScale, Mode=OneWay}" HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </Grid>
          <ItemsControl x:Name="DailyChart" ItemsSource="{x:Bind ViewModel.DailyBars, Mode=OneWay}"
                        ItemTemplate="{StaticResource BarTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <controls:EqualColumnPanel Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Grid x:Name="PatternGrid" ColumnSpacing="16" RowSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="12">
            <TextBlock Text="{helpers:Localize KeyName=RefineWhenYouPlay}"
                       Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ScrollViewer SizeChanged="Heatmap_SizeChanged" HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
              <StackPanel x:Name="HeatmapContent" MinWidth="320" Spacing="4">
                <Grid Margin="32,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="00" />
                  <TextBlock Grid.Column="1" Text="06" />
                  <TextBlock Grid.Column="2" Text="12" />
                  <TextBlock Grid.Column="3" Text="18" />
                  <TextBlock Grid.Column="3" Text="24" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Heatmap, Mode=OneWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaytimeHeatRowViewModel">
                      <Grid ColumnSpacing="4" Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="28" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Label}" Style="{ThemeResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Cells}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <controls:EqualColumnPanel Spacing="3" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaytimeHeatCellViewModel">
                              <Button Style="{StaticResource HeatmapMark}"
                                      Background="{ThemeResource AccentFillColorDefaultBrush}"
                                      Opacity="{x:Bind Opacity}"
                                      AutomationProperties.Name="{x:Bind HelpText}"
                                      ToolTipService.ToolTip="{x:Bind HelpText}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
              <TextBlock Text="{helpers:Localize KeyName=RefineLess}" Style="{ThemeResource CaptionTextBlockStyle}" />
              <Border Width="16" Height="16" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.15" />
              <Border Width="16" Height="16" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.5" />
              <Border Width="16" Height="16" Background="{ThemeResource AccentFillColorDefaultBrush}" />
              <TextBlock Text="{helpers:Localize KeyName=RefineMore}" Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel Spacing="16">
            <TextBlock Text="{helpers:Localize KeyName=RefinePatterns}" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE787;" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{helpers:Localize KeyName=RefineMostPlayedDate}"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.BestDate, Mode=OneWay}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.BestDateDuration, Mode=OneWay}" />
              </StackPanel>
            </Grid>
            <StackPanel Spacing="4">
              <TextBlock Text="{helpers:Localize KeyName=RefineFavoriteDay}"
                         Style="{ThemeResource CaptionTextBlockStyle}" />
              <TextBlock Text="{x:Bind ViewModel.FavoriteDay, Mode=OneWay}"
                         Style="{ThemeResource BodyStrongTextBlockStyle}" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.WeekdayBars, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <controls:EqualColumnPanel Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PlaytimeBarViewModel">
                    <Grid Height="72" ToolTipService.ToolTip="{x:Bind Duration}">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="24" />
                      </Grid.RowDefinitions>
                      <Border Height="{x:Bind Height}" VerticalAlignment="Bottom"
                              Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="2" />
                      <TextBlock Grid.Row="1" Text="{x:Bind Label}" Style="{ThemeResource CaptionTextBlockStyle}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <SymbolIcon Symbol="Clock" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{helpers:Localize KeyName=RefinePeakHour}"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.PeakHour, Mode=OneWay}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.PeakDuration, Mode=OneWay}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
      <Grid x:Name="HistoryGrid" ColumnSpacing="16" RowSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" VerticalAlignment="Stretch">
          <StackPanel Spacing="16">
            <TextBlock Text="{helpers:Localize KeyName=RefineInstanceRanking}"
                       Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Rankings, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaytimeRankingRow">
                  <StackPanel Spacing="8" Margin="0,0,0,16">
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Bind Rank}" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{x:Bind Duration}" />
                    </Grid>
                    <ProgressBar Value="{x:Bind Proportion}" Maximum="100" IsHitTestVisible="False" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{x:Bind ViewModel.RankingPageText, Mode=OneWay}"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Click="PreviousRanking_Click" Content="{helpers:Localize KeyName=RefinePrevious}"
                      IsEnabled="{x:Bind ViewModel.CanPreviousRanking, Mode=OneWay}" />
              <Button Click="NextRanking_Click" Content="{helpers:Localize KeyName=RefineNext}"
                      IsEnabled="{x:Bind ViewModel.CanNextRanking, Mode=OneWay}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Stretch">
          <StackPanel Spacing="16">
            <TextBlock Text="{helpers:Localize KeyName=RefineSessions}" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaytimeSessionRow">
                  <Grid ColumnSpacing="12" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="24" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind Glyph}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                 Style="{ThemeResource BodyStrongTextBlockStyle}" />
                      <TextBlock Text="{x:Bind Target}" TextTrimming="CharacterEllipsis"
                                 Style="{ThemeResource CaptionTextBlockStyle}"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Text="{x:Bind Duration}" HorizontalAlignment="Right" />
                      <TextBlock Text="{x:Bind Started}" Style="{ThemeResource CaptionTextBlockStyle}"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind ViewModel.SessionPageText, Mode=OneWay}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Click="PreviousSession_Click" Content="{helpers:Localize KeyName=RefinePrevious}"
                      IsEnabled="{x:Bind ViewModel.CanPreviousSession, Mode=OneWay}" />
              <Button Grid.Column="2" Click="NextSession_Click" Content="{helpers:Localize KeyName=RefineNext}"
                      IsEnabled="{x:Bind ViewModel.CanNextSession, Mode=OneWay}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Page>
