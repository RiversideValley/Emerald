<Page
  x:Class="Emerald.Views.Settings.AdvancedPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:cn="using:CommunityToolkit.WinUI.Controls"
  xmlns:conv="using:Emerald.Helpers.Converters"
  xmlns:helpers="using:Emerald.Helpers">

  <Page.Resources>
    <conv:BoolToVisibility x:Key="BoolToVis" />
  </Page.Resources>

  <Grid Margin="16">
    <StackPanel Spacing="4">
      <TextBlock FontWeight="SemiBold" Text="{helpers:Localize KeyName=Ely.by}" />
      <cn:SettingsCard
        Header="{helpers:Localize KeyName=AuthlibInjectorVersion}"
        Description="{helpers:Localize KeyName=AuthlibInjectorGlobalDescription}"
        HeaderIcon="{helpers:FontIcon Glyph=&#xE943;}">
        <ComboBox
          DisplayMemberPath="Label"
          ItemsSource="{Binding ModeOptions}"
          SelectedItem="{Binding SelectedMode, Mode=TwoWay}" />
      </cn:SettingsCard>

      <cn:SettingsCard Header="{helpers:Localize KeyName=AuthlibCustomVersion}"
                       Description="{helpers:Localize KeyName=AuthlibCustomVersionDescription}"
                       Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVis}}">
        <StackPanel Spacing="8">
          <ComboBox
            DisplayMemberPath="Label"
            ItemsSource="{Binding Versions}"
            SelectedItem="{Binding SelectedVersion, Mode=TwoWay}" />
          <ProgressRing
            Width="20" Height="20" HorizontalAlignment="Left"
            IsActive="{Binding IsCatalogLoading}"
            Visibility="{Binding IsCatalogLoading, Converter={StaticResource BoolToVis}}" />
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      Visibility="{Binding HasCatalogError, Converter={StaticResource BoolToVis}}">
            <TextBlock
              MaxWidth="420"
              VerticalAlignment="Center"
              Text="{Binding CatalogErrorMessage}" TextWrapping="Wrap" />
            <Button Command="{Binding LoadCatalogCommand}" Content="{helpers:Localize KeyName=Retry}" />
          </StackPanel>
        </StackPanel>
      </cn:SettingsCard>

      <cn:SettingsCard
        IsClickEnabled="True"
        Header="{helpers:Localize
        KeyName=AuthlibCheckConfiguration}"
        Description="{helpers:Localize KeyName=AuthlibCheckConfigurationDescription}"
        HeaderIcon="{helpers:FontIcon Glyph=&#xE73E;}"
        Command="{Binding CheckConfigurationCommand}">
        <StackPanel MinWidth="260" Spacing="8">
          <ProgressRing Width="20" Height="20" HorizontalAlignment="Left"
                        IsActive="{Binding IsChecking}"
                        Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
          <TextBlock MaxWidth="520" IsTextSelectionEnabled="True" Text="{Binding ConfigurationStatus}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </cn:SettingsCard>
    </StackPanel>
  </Grid>
</Page>
