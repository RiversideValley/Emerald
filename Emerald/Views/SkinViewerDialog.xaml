<ContentDialog
    x:Class="Emerald.Views.SkinViewerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cn="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:Emerald.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Emerald.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FullSizeDesired="True"
    VerticalAlignment="Stretch"
    HorizontalAlignment="Stretch"
    MaxWidth="4096"
    Margin="12"
    Background="{ThemeResource ContentDialogBackground}"
    DefaultButton="Close">

  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">4096</x:Double>
    <x:Double x:Key="ContentDialogMaxHeight">2048</x:Double>

    <Style x:Key="LayerCheckBoxStyle" BasedOn="{StaticResource DefaultCheckBoxStyle}" TargetType="CheckBox">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </ContentDialog.Resources>

  <Grid
      x:Name="RootGrid"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Main scroll container for full adaptation on narrow/small viewports -->
    <ScrollViewer
        x:Name="MainScrollViewer"
        Grid.Row="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

      <Grid
          x:Name="ContentLayoutGrid"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="ViewerColumn" Width="*" />
          <ColumnDefinition x:Name="SettingsColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition x:Name="ViewerRow" Height="*" />
          <RowDefinition x:Name="SettingsRow" Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 3D Skin Viewer Viewport -->
        <Grid
            x:Name="ViewerContainer"
            Grid.Row="0"
            Grid.Column="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8"
            MinHeight="360"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
          <Image
              x:Name="FallbackPreview"
              Stretch="Uniform"
              Visibility="Collapsed" />
          <controls:MinecraftSkinWebView
              x:Name="SkinWebView"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch" />
          <StackPanel
              x:Name="LoadingPanel"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="12">
            <ProgressRing
                IsActive="True"
                Width="32"
                Height="32" />
            <TextBlock
                Text="{helpers:Localize KeyName=SkinLoading}"
                TextAlignment="Center" />
          </StackPanel>
        </Grid>

        <!-- Settings Area: Normal Grid, positioned on right or stacked below on narrow windows -->
        <Grid
            x:Name="SettingsContainer"
            Grid.Row="0"
            Grid.Column="1"
            Visibility="Collapsed"
            Margin="16,0">
          <StackPanel
              x:Name="SettingsPanel"
              Spacing="8"
              HorizontalAlignment="Stretch">

            <!-- Animation Expander -->
            <cn:SettingsExpander
                Header="{helpers:Localize KeyName=SkinViewerAnimation}"
                Description="{helpers:Localize KeyName=SkinViewerAnimationDescription}"
                HeaderIcon="{helpers:FontIcon Glyph=&#xE768;}"
                IsExpanded="False">
              <cn:SettingsExpander.Content>
                <ComboBox
                    x:Name="AnimationComboBox"
                    MinWidth="130"
                    SelectedIndex="1"
                    SelectionChanged="ComboBox_SelectionChanged">
                  <ComboBoxItem Content="{helpers:Localize KeyName=SkinViewerAnimationNone}" Tag="None" />
                  <ComboBoxItem Content="{helpers:Localize KeyName=SkinViewerAnimationIdle}" Tag="Idle" />
                  <ComboBoxItem Content="{helpers:Localize KeyName=SkinViewerAnimationWalk}" Tag="Walk" />
                  <ComboBoxItem Content="{helpers:Localize KeyName=SkinViewerAnimationRun}" Tag="Run" />
                  <ComboBoxItem Content="{helpers:Localize KeyName=SkinViewerAnimationFly}" Tag="Fly" />
                  <ComboBoxItem Content="{helpers:Localize KeyName=SkinViewerAnimationWave}" Tag="Wave" />
                  <ComboBoxItem Content="{helpers:Localize KeyName=SkinViewerAnimationCrouch}" Tag="Crouch" />
                  <ComboBoxItem Content="{helpers:Localize KeyName=SkinViewerAnimationHit}" Tag="Hit" />
                  <ComboBoxItem Content="{helpers:Localize KeyName=SkinViewerAnimationSwim}" Tag="Swim" />
                </ComboBox>
              </cn:SettingsExpander.Content>
              <cn:SettingsExpander.Items>
                <cn:SettingsCard
                    Header="{helpers:Localize KeyName=SkinViewerAnimationSpeed}"
                    Description="{helpers:Localize KeyName=SkinViewerAnimationSpeedDescription}">
                  <Slider
                      x:Name="AnimationSpeedSlider"
                      Minimum="0"
                      Maximum="3"
                      StepFrequency="0.1"
                      Value="1"
                      Width="130"
                      ValueChanged="Slider_ValueChanged" />
                </cn:SettingsCard>
              </cn:SettingsExpander.Items>
            </cn:SettingsExpander>

            <!-- Appearance Expander -->
            <cn:SettingsExpander
                Header="{helpers:Localize KeyName=SkinViewerAppearance}"
                Description="{helpers:Localize KeyName=SkinViewerAppearanceDescription}"
                HeaderIcon="{helpers:FontIcon Glyph=&#xE790;}"
                IsExpanded="False">
              <cn:SettingsExpander.Content>
                <ToggleSwitch
                    x:Name="RotationEnabledToggle"
                    IsOn="True"
                    Toggled="ToggleSwitch_Toggled" />
              </cn:SettingsExpander.Content>
              <cn:SettingsExpander.Items>
                <cn:SettingsCard
                    Header="{helpers:Localize KeyName=SkinViewerRotationSpeed}"
                    Description="{helpers:Localize KeyName=SkinViewerRotationSpeedDescription}">
                  <Slider
                      x:Name="RotationSpeedSlider"
                      Minimum="0"
                      Maximum="1"
                      StepFrequency="0.025"
                      Value="0.1745"
                      Width="130"
                      ValueChanged="Slider_ValueChanged" />
                </cn:SettingsCard>
                <cn:SettingsCard
                    Header="{helpers:Localize KeyName=SkinViewerBackEquipment}"
                    Description="{helpers:Localize KeyName=SkinViewerBackEquipmentDescription}">
                  <ComboBox
                      x:Name="BackEquipmentComboBox"
                      MinWidth="130"
                      SelectedIndex="0"
                      SelectionChanged="ComboBox_SelectionChanged">
                    <ComboBoxItem Content="{helpers:Localize KeyName=SkinViewerBackEquipmentNone}" Tag="None" />
                    <ComboBoxItem Content="{helpers:Localize KeyName=SkinViewerCape}" Tag="Cape" />
                    <ComboBoxItem Content="{helpers:Localize KeyName=SkinViewerElytra}" Tag="Elytra" />
                  </ComboBox>
                </cn:SettingsCard>
                <cn:SettingsCard
                    Header="{helpers:Localize KeyName=SkinViewerCapeTexture}"
                    Description="{helpers:Localize KeyName=SkinViewerCapeTextureDescription}">
                  <Grid ColumnSpacing="8" MinWidth="220" MaxWidth="320">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="CapeUrlBox"
                        PlaceholderText="{helpers:Localize KeyName=SkinViewerCapeUrlPlaceholder}"
                        TextChanged="CapeUrlBox_TextChanged"
                        VerticalAlignment="Center" />
                    <Button
                        Grid.Column="1"
                        Click="BrowseCape_Click"
                        ToolTipService.ToolTip="{helpers:Localize KeyName=SkinViewerBrowseCape}"
                        VerticalAlignment="Center">
                      <FontIcon Glyph="&#xED25;" FontSize="14" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        Click="ClearCape_Click"
                        ToolTipService.ToolTip="{helpers:Localize KeyName=SkinViewerClearCape}"
                        VerticalAlignment="Center">
                      <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                  </Grid>
                </cn:SettingsCard>
              </cn:SettingsExpander.Items>
            </cn:SettingsExpander>

            <!-- Layers Expander: Direct grid in ItemsHeader, no SettingsCard -->
            <cn:SettingsExpander
                Header="{helpers:Localize KeyName=SkinViewerLayers}"
                Description="{helpers:Localize KeyName=SkinViewerLayersDescription}"
                HeaderIcon="{helpers:FontIcon Glyph=&#xE8B9;}"
                IsExpanded="False">
              <cn:SettingsExpander.ItemsHeader>
                <Border
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="0,0,4,4"
                    Padding="16,12"
                    HorizontalAlignment="Stretch">
                  <Grid
                      ColumnSpacing="10"
                      RowSpacing="10"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="60" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Column Headers -->
                    <TextBlock
                        Grid.Column="1"
                        Grid.Row="0"
                        Text="{helpers:Localize KeyName=SkinViewerHead}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Column="2"
                        Grid.Row="0"
                        Text="{helpers:Localize KeyName=SkinViewerBody}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Column="3"
                        Grid.Row="0"
                        Text="{helpers:Localize KeyName=SkinViewerRightArm}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Column="4"
                        Grid.Row="0"
                        Text="{helpers:Localize KeyName=SkinViewerLeftArm}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Column="5"
                        Grid.Row="0"
                        Text="{helpers:Localize KeyName=SkinViewerRightLeg}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Column="6"
                        Grid.Row="0"
                        Text="{helpers:Localize KeyName=SkinViewerLeftLeg}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"
                        TextWrapping="WrapWholeWords" />

                    <!-- Row Labels -->
                    <TextBlock
                        Grid.Column="0"
                        Grid.Row="1"
                        Text="{helpers:Localize KeyName=SkinViewerInner}"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Grid.Column="0"
                        Grid.Row="2"
                        Text="{helpers:Localize KeyName=SkinViewerOuter}"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}" />

                    <!-- Inner Checkboxes -->
                    <CheckBox
                        x:Name="HeadInnerCheck"
                        Grid.Column="1"
                        Grid.Row="1"
                        Style="{StaticResource LayerCheckBoxStyle}"
                        IsChecked="True"
                        Checked="CheckBox_CheckChanged"
                        Unchecked="CheckBox_CheckChanged" />
                    <CheckBox
                        x:Name="BodyInnerCheck"
                        Grid.Column="2"
                        Grid.Row="1"
                        Style="{StaticResource LayerCheckBoxStyle}"
                        IsChecked="True"
                        Checked="CheckBox_CheckChanged"
                        Unchecked="CheckBox_CheckChanged" />
                    <CheckBox
                        x:Name="RightArmInnerCheck"
                        Grid.Column="3"
                        Grid.Row="1"
                        Style="{StaticResource LayerCheckBoxStyle}"
                        IsChecked="True"
                        Checked="CheckBox_CheckChanged"
                        Unchecked="CheckBox_CheckChanged" />
                    <CheckBox
                        x:Name="LeftArmInnerCheck"
                        Grid.Column="4"
                        Grid.Row="1"
                        Style="{StaticResource LayerCheckBoxStyle}"
                        IsChecked="True"
                        Checked="CheckBox_CheckChanged"
                        Unchecked="CheckBox_CheckChanged" />
                    <CheckBox
                        x:Name="RightLegInnerCheck"
                        Grid.Column="5"
                        Grid.Row="1"
                        Style="{StaticResource LayerCheckBoxStyle}"
                        IsChecked="True"
                        Checked="CheckBox_CheckChanged"
                        Unchecked="CheckBox_CheckChanged" />
                    <CheckBox
                        x:Name="LeftLegInnerCheck"
                        Grid.Column="6"
                        Grid.Row="1"
                        Style="{StaticResource LayerCheckBoxStyle}"
                        IsChecked="True"
                        Checked="CheckBox_CheckChanged"
                        Unchecked="CheckBox_CheckChanged" />

                    <!-- Outer Checkboxes -->
                    <CheckBox
                        x:Name="HeadOuterCheck"
                        Grid.Column="1"
                        Grid.Row="2"
                        Style="{StaticResource LayerCheckBoxStyle}"
                        IsChecked="True"
                        Checked="CheckBox_CheckChanged"
                        Unchecked="CheckBox_CheckChanged" />
                    <CheckBox
                        x:Name="BodyOuterCheck"
                        Grid.Column="2"
                        Grid.Row="2"
                        Style="{StaticResource LayerCheckBoxStyle}"
                        IsChecked="True"
                        Checked="CheckBox_CheckChanged"
                        Unchecked="CheckBox_CheckChanged" />
                    <CheckBox
                        x:Name="RightArmOuterCheck"
                        Grid.Column="3"
                        Grid.Row="2"
                        Style="{StaticResource LayerCheckBoxStyle}"
                        IsChecked="True"
                        Checked="CheckBox_CheckChanged"
                        Unchecked="CheckBox_CheckChanged" />
                    <CheckBox
                        x:Name="LeftArmOuterCheck"
                        Grid.Column="4"
                        Grid.Row="2"
                        Style="{StaticResource LayerCheckBoxStyle}"
                        IsChecked="True"
                        Checked="CheckBox_CheckChanged"
                        Unchecked="CheckBox_CheckChanged" />
                    <CheckBox
                        x:Name="RightLegOuterCheck"
                        Grid.Column="5"
                        Grid.Row="2"
                        Style="{StaticResource LayerCheckBoxStyle}"
                        IsChecked="True"
                        Checked="CheckBox_CheckChanged"
                        Unchecked="CheckBox_CheckChanged" />
                    <CheckBox
                        x:Name="LeftLegOuterCheck"
                        Grid.Column="6"
                        Grid.Row="2"
                        Style="{StaticResource LayerCheckBoxStyle}"
                        IsChecked="True"
                        Checked="CheckBox_CheckChanged"
                        Unchecked="CheckBox_CheckChanged" />
                  </Grid>
                </Border>
              </cn:SettingsExpander.ItemsHeader>
            </cn:SettingsExpander>

          </StackPanel>
        </Grid>

      </Grid>
    </ScrollViewer>

    <TextBlock
        x:Name="StatusTextBlock"
        Grid.Row="1"
        Margin="0,6,0,0"
        TextAlignment="Center"
        VerticalAlignment="Center"
        TextWrapping="WrapWholeWords"
        Visibility="Collapsed" />
  </Grid>
</ContentDialog>
