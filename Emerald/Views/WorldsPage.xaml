<Page x:Class="Emerald.Views.WorldsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:worlds="using:Emerald.CoreX.Services.Worlds" xmlns:helpers="using:Emerald.Helpers" Background="Transparent">
  <Grid Padding="24,12,24,24" RowSpacing="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="&#xE72B;" FontFamily="Segoe Fluent Icons" Click="Back_Click" AutomationProperties.Name="{helpers:Localize KeyName=BackToHome}" /><StackPanel Grid.Column="1"><TextBlock Text="{helpers:Localize KeyName=LocalWorlds}" Style="{ThemeResource TitleTextBlockStyle}" /><TextBlock Text="{helpers:Localize KeyName=WorldsPageDescription}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><Button Grid.Column="2" Content="{helpers:Localize KeyName=Refresh}" Click="Refresh_Click" /></Grid>
    <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox PlaceholderText="{helpers:Localize KeyName=SearchWorlds}" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{helpers:Localize KeyName=SearchLocalWorlds}" /><ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.Sorts}" SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" /><ComboBox Grid.Column="2" MinWidth="190" ItemsSource="{x:Bind ViewModel.Games}" SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}" DisplayMemberPath="Version.DisplayName" /></Grid>
    <Border Grid.Row="2" Padding="12" CornerRadius="8" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"><TextBlock Text="{x:Bind ViewModel.LaunchLimitation, Mode=OneWay}" TextWrapping="Wrap" /></Border>
    <Grid Grid.Row="3"><ListView ItemsSource="{x:Bind ViewModel.FilteredWorlds, Mode=OneWay}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="worlds:MinecraftWorld"><Border Margin="0,0,0,10" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="56" Height="56" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8"><Grid><FontIcon Glyph="&#xE909;" /><Image Source="{x:Bind IconPath}" Stretch="UniformToFill" /></Grid></Border><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{x:Bind DisplayName}" Style="{ThemeResource BodyStrongTextBlockStyle}" /><TextBlock Text="{x:Bind FolderName}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind GameMode}" /><TextBlock Text="{x:Bind MinecraftVersion}" /><TextBlock Text="{x:Bind LastPlayed}" /><TextBlock Text="{x:Bind SizeText, Mode=OneWay}" /></StackPanel><TextBlock Text="{x:Bind Warning}" Foreground="{ThemeResource SystemFillColorCautionBrush}" /></StackPanel><Button Grid.Column="2" Tag="{x:Bind}" Click="Reveal_Click" ToolTipService.ToolTip="{helpers:Localize KeyName=RevealInFileManager}"><FontIcon Glyph="&#xE838;" /></Button><Button Grid.Column="3" Tag="{x:Bind}" Click="Details_Click" ToolTipService.ToolTip="{helpers:Localize KeyName=WorldDetails}"><FontIcon Glyph="&#xE946;" /></Button><Button Grid.Column="4" Tag="{x:Bind}" Click="Launch_Click" Style="{ThemeResource AccentButtonStyle}" Content="{helpers:Localize KeyName=Play}" IsEnabled="{x:Bind CanQuickLaunch, Mode=OneWay}" /></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView><ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
  </Grid>
</Page>
