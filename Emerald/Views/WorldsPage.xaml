<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Emerald.ViewModels"
      xmlns:controls="using:Emerald.Controls" xmlns:helpers="using:Emerald.Helpers"
      xmlns:conv="using:Emerald.Helpers.Converters" x:Class="Emerald.Views.WorldsPage" Background="Transparent">
  <Page.Resources>
    <conv:BoolToVisibility x:Key="Visible" />
  </Page.Resources>
  <Grid x:Name="LayoutRoot" Padding="24" RowSpacing="16" SizeChanged="Layout_SizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Click="Back_Click" AutomationProperties.Name="{helpers:Localize KeyName=RefineBack}">
        <FontIcon Glyph="&#xE72B;" />
      </Button>
      <StackPanel Grid.Column="1">
        <TextBlock Text="{helpers:Localize KeyName=RefineLocalWorlds}" Style="{ThemeResource TitleTextBlockStyle}" />
        <TextBlock Text="{helpers:Localize KeyName=RefineSelectHome}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <Button Grid.Column="2" Click="Refresh_Click" Content="{helpers:Localize KeyName=RefineRefresh}" />
    </Grid>
    <Border Grid.Row="1" Padding="16,12" CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <Grid x:Name="Filters" ColumnSpacing="12" RowSpacing="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <AutoSuggestBox BorderThickness="0,0,0,1" Background="Transparent"
                        QueryIcon="{helpers:FontIcon Glyph=&#xE721;}"
                        PlaceholderText="{helpers:Localize KeyName=RefineSearchWorlds}"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{helpers:Localize KeyName=RefineSearchWorlds}" />
        <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.Sorts}"
                  SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" DisplayMemberPath="Label"
                  AutomationProperties.Name="{helpers:Localize KeyName=RefineSort}" />
        <ComboBox x:Name="InstancePicker" Grid.Column="2" ItemsSource="{x:Bind ViewModel.Games}"
                  SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="{helpers:Localize KeyName=RefineInstance}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Version.DisplayName}" TextTrimming="CharacterEllipsis" MaxWidth="236"
                         ToolTipService.ToolTip="{Binding Version.DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </Border>
    <StackPanel Grid.Row="2">
      <InfoBar IsOpen="{x:Bind ViewModel.HasLimitation, Mode=OneWay}"
               Message="{x:Bind ViewModel.LaunchLimitation, Mode=OneWay}" Severity="Warning" IsClosable="False" />
      <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
               Severity="Error" IsClosable="False" />
    </StackPanel>
    <Grid Grid.Row="3">
      <ListView ItemsSource="{x:Bind ViewModel.FilteredWorlds, Mode=OneWay}" SelectionMode="None">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:WorldRowViewModel">
            <Grid CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <Button Click="Select_Click" Tag="{x:Bind}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" Padding="16,16,156,16" BorderThickness="0"
                      Background="Transparent" AutomationProperties.Name="{x:Bind Name}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <controls:WorldThumbnail Width="56" Height="56" Path="{x:Bind IconPath}" />
                  <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Metadata}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Warning}"
                               Visibility="{x:Bind HasWarning, Converter={StaticResource Visible}}"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                  </StackPanel>
                  <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" />
                </Grid>
              </Button>
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,16,0">
                <Button Tag="{x:Bind}" Click="Menu_Click"
                        AutomationProperties.Name="{helpers:Localize KeyName=RefineWorldOptions}"
                        ToolTipService.ToolTip="{helpers:Localize KeyName=RefineWorldOptions}">
                  <FontIcon Glyph="&#xE712;" />
                </Button>
                <Button Tag="{x:Bind}" Click="Launch_Click" Content="{helpers:Localize KeyName=RefinePlay}"
                        IsEnabled="{x:Bind CanLaunch}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
      <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                 Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource Visible}}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Page>
